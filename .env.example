# ==============================================================================
# OnlyFails - Fails & Unexpected Memes YouTube Shorts Automation Settings
# ==============================================================================

# ── DATA DIRECTORY ────────────────────────────────────────────────────────────
DATA_DIR_NAME=data

# ── SUBREDDITS & INGESTION CONFIGURATION ──────────────────────────────────────
SUBREDDITS=Whatcouldgowrong, Unexpected, AccidentalSlapStick
REDDIT_SORT=best
REDDIT_TIME_FILTER=week
REDDIT_MIN_SCORE=100
REDDIT_MIN_COMMENTS=10
ONLY_VIDEOS=True

# Optional: Reddit API credentials (if empty, uses anonymous feeds / Redlib rotation)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=OnlyFailsBot/1.0

# ── CURATOR VIDEO SETTINGS ────────────────────────────────────────────────────
CURATOR_MODE=True
MAX_MEME_DURATION=59
MIN_MEME_DURATION=3
FIT_CLIP_WIDTH=True
BRANDING_TEXT=
ADD_INTRO_OUTRO=False

# ── CHANNEL BRANDING & CREATOR CARD ───────────────────────────────────────────
PROFILE_PICTURE_PATH="data/assets/OnlyFails Cyan Wing Logo.png"
CHANNEL_DISPLAY_NAME="OnlyFails"
CHANNEL_HANDLE="@onlyfail.s"
BADGE_COLOR="#1DA1F2"
BACKGROUND_COLOR="#FFFFFF"

# ── CONTENT SAFETY ────────────────────────────────────────────────────────────
ENABLE_CONTENT_SAFETY=True
SAFETY_MODE=standard
MAX_ALLOWED_RISK=low

# Optional: AI API Keys (if empty, local safety rules & Reddit titles are used)
GROQ_API_KEY=
GEMINI_API_KEY=

# ── YOUTUBE API CREDENTIALS ───────────────────────────────────────────────────
YT_CLIENT_ID=
YT_CLIENT_SECRET_VALUE=
YT_REFRESH_TOKEN=
YOUTUBE_PRIVACY=public
YOUTUBE_CATEGORY_ID=24

# ── METADATA & SEO ────────────────────────────────────────────────────────────
METADATA_MENTIONS=
METADATA_TRENDING_TAGS=whatcouldgowrong, wcgw, unexpected, instantregret, instantkarma, fail, fails, viral, shorts
METADATA_DISCLAIMER=Curated funny fail & unexpected clips from Reddit.

# ── SCHEDULER & LIMITS ────────────────────────────────────────────────────────
MAX_VIDEOS_PER_DAY=4
UPLOAD_SCHEDULE_TIMES=09:00, 13:00, 17:00, 21:00
